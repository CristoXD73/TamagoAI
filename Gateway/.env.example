# Copy to your shell profile or a local, git-ignored .env and export before `npm start`.
# NEVER commit real values.

# Bind address. 127.0.0.1 for simulator work; your Mac's LAN interface (or 0.0.0.0)
# so a physical Watch on the same Wi-Fi can reach it. Never expose to the internet.
TAMAGO_HOST=127.0.0.1
TAMAGO_PORT=8787

# Required unless TAMAGO_ALLOW_NO_AUTH=1 on loopback. At least 16 characters.
# Generate one with:  openssl rand -hex 24
TAMAGO_TOKEN=

# mock | ollama
TAMAGO_PROVIDER=mock
TAMAGO_TIMEOUT_MS=20000

# Only for TAMAGO_PROVIDER=ollama (UNVERIFIED_LOCAL_PROVIDER)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
