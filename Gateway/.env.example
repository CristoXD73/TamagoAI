# Copy to your shell profile or a local, git-ignored .env and export before `npm start`.
# NEVER commit real values.

# Bind address. 127.0.0.1 for simulator work; your Mac's LAN interface (or 0.0.0.0)
# so a physical Watch on the same Wi-Fi can reach it. Never expose to the internet.
TAMAGO_HOST=127.0.0.1
TAMAGO_PORT=8787

# Required unless TAMAGO_ALLOW_NO_AUTH=1 on loopback. At least 16 characters.
# Generate one with:  openssl rand -hex 24
TAMAGO_TOKEN=

# mock | ollama | brain
TAMAGO_PROVIDER=mock
TAMAGO_TIMEOUT_MS=20000

# Only for TAMAGO_PROVIDER=ollama (UNVERIFIED_LOCAL_PROVIDER)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Only for TAMAGO_PROVIDER=brain (docs/BRAIN_ARCHITECTURE.md)
# ollama (default when a model is set) | deterministic (offline fallback, no model)
TAMAGO_REASONER=
# fast model for everyday replies; smart model for complex questions.
# With TAMAGO_REASONER=ollama and neither set: llama3.2:3b for both (D-118, docs/BRAIN_EVAL.md).
TAMAGO_FAST_MODEL=
TAMAGO_SMART_MODEL=
# Owner's Mac: keep models on the Storage disk (AGENTS.md §9): OLLAMA_MODELS=/Volumes/Storage/AI/ollama/models
# default: <TAMAGO_STATE_DIR or ~/Library/Application Support/TamagoAI>/brain.sqlite (never in the repo)
TAMAGO_BRAIN_DB=

# Natural voice (D-121, PROTOCOL_V1 §16). off (default) | kokoro | kitten | say
# Install the engine first: Gateway/tools/tts/setup.sh (local only; downloads to the Storage disk).
TAMAGO_TTS=off
# Owner's Mac: /Volumes/Storage/AI/tts (AGENTS.md §9). Holds sherpa-onnx/ and models/.
TAMAGO_TTS_MODEL_DIR=
# kokoro: af_heart (default) | af_bella | bf_emma | am_michael. kitten: expr-voice-4-f. say: a Premium voice name.
TAMAGO_TTS_VOICE=
# 0.5–2.0; 1.0 default (0.9 is a calmer candidate)
TAMAGO_TTS_SPEED=
# default: Gateway/tools/tts/tamago-tts
TAMAGO_TTS_COMMAND=
