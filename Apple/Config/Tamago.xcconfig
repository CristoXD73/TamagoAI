// Tamago.xcconfig: identity and signing shared by every Apple target.
// See docs/DECISIONS.md D-101 and D-109.
//
// Placeholders only. Put the real values in Apple/Config/Local.xcconfig
// (git-ignored), for example:
//
//   TAMAGO_BUNDLE_PREFIX = com.yourname.appletamago
//   DEVELOPMENT_TEAM = ABCDE12345
//
// Never commit a team ID or a personal bundle prefix.

TAMAGO_BUNDLE_PREFIX = com.example.appletamago
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// App icons: Apple/WatchApp and Apple/iPhoneApp each carry Assets.xcassets/AppIcon
// (owner-approved reference art on black, see Assets/CharacterReference/octopus-v001/PROVENANCE.md).
// Only the two apps have an icon; the complication's catalog holds its art only.
TAMAGO_APPICON_TamagoWatch = AppIcon
TAMAGO_APPICON_TamagoPhone = AppIcon
ASSETCATALOG_COMPILER_APPICON_NAME = $(TAMAGO_APPICON_$(TARGET_NAME))

// TestFlight/App Store export compliance: the apps use no encryption beyond the
// OS's own (plain HTTP on the LAN, Keychain), so uploads don't stop to ask.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

#include? "Local.xcconfig"
